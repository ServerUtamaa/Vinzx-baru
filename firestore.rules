rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitives
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isBackendSync() {
      return isSignedIn() && request.auth.uid == 'CwrnqMbTWYO8Np2CyA2wz16Wwyd2';
    }

    function isMasterAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'mayasalfakihmukadam@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isValidUserSelfCreate() {
      return incoming().keys().size() <= 10
        && !incoming().keys().hasAny([
          'role', 'membershipTier', 'membershipExpiresAt', 'tokens',
          'password', 'passwordHash', 'integritySignature', 'trialActivated'
        ])
        && (!incoming().keys().hasAny(['history']) || (incoming().history is list && incoming().history.size() <= 50));
    }

    function isValidUserSelfUpdate() {
      return incoming().keys().size() <= 20
        && !incoming().diff(existing()).affectedKeys().hasAny([
          'id', 'role', 'membershipTier', 'membershipExpiresAt', 'tokens',
          'password', 'passwordHash', 'integritySignature', 'trialActivated'
        ])
        && (!incoming().keys().hasAny(['history']) || (incoming().history is list && incoming().history.size() <= 500));
    }

    // User Profiles & Trade History
    match /users/{userId} {
      allow get: if isValidId(userId) && (isBackendSync() || isMasterAdmin() || (isSignedIn() && request.auth.uid == userId));
      allow list: if isBackendSync() || isMasterAdmin();
      allow create: if isValidId(userId) && (
        isBackendSync()
        || isMasterAdmin()
        || (isSignedIn() && request.auth.uid == userId && isValidUserSelfCreate())
      );
      allow update: if isValidId(userId) && (
        isBackendSync()
        || isMasterAdmin()
        || (isSignedIn() && request.auth.uid == userId && isValidUserSelfUpdate())
      );
      allow delete: if isValidId(userId) && (isBackendSync() || isMasterAdmin());
    }

    // Encrypted Backend Snapshot (Strictly locked to Backend Sync UID only)
    match /server_backup/{docId} {
      allow get, create, update, delete: if isValidId(docId) && isBackendSync();
      allow list: if isBackendSync();
    }

    // AI Learning Memory
    match /ai_memory/{docId} {
      allow get: if isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isValidId(docId) && isSignedIn() && incoming().keys().size() <= 20;
      allow delete: if false;
    }

    // Global Trade History for AI Training
    match /global_trade_history/{docId} {
      allow get: if isValidId(docId);
      allow list: if isSignedIn();
      allow create, update: if isValidId(docId)
        && (isMasterAdmin() || isBackendSync())
        && incoming().keys().hasOnly(['history'])
        && incoming().history is list
        && incoming().history.size() <= 5000;
      allow delete: if false;
    }
  }
}
